# Plataforma web Qhub — variables de build (Vercel las inyecta en el build).
# Todas son PUBLICAS (van en el bundle). No pongas aqui claves secretas.
VITE_APP_ENV=production
# API Qhub publica (Render). Usa https:// y wss://
VITE_QHUB_API_BASE_URL=            # p.ej. https://qhub-api.onrender.com
VITE_QHUB_WS_BASE_URL=             # p.ej. wss://qhub-api.onrender.com
# Supabase (proyecto Qhub_App) — valores PUBLICOS del panel de Supabase
VITE_SUPABASE_URL=                 # p.ej. https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=     # la anon/publishable key (publica)
