{
  "name": "qhub-web",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "generate": "npm run generate -w @qhub/design",
    "build": "npm run generate -w @qhub/design && npm run build -w @qhub/web"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "@types/react": "~19.3.0"
  }
}
